# GitHub Personal Access Token — required for private repos
GITHUB_TOKEN=ghp_your_token_here

# Poll interval in seconds
POLL_INTERVAL_SECONDS=60

# Repos to watch. Format: owner/repo:branch[:path1,path2]
# Multiple targets separated by |
WATCH_TARGETS=Viavi-TestCenter/testcenter:integration:content/traffic/ccl

# Comma-separated list of skills to run for each commit (in order).
# Leave empty to disable all processing.
# Example: SKILL_LIST=compile_ui_bll_skill,regression_test_skill
SKILL_LIST=

# ── Skill: compile_ui_bll_skill ───────────────────────────────────────────────
# Local path to the testcenter git repo
TESTCENTER_REPO=C:\work\testcenter

# ── Skill: regression_test_skill ──────────────────────────────────────────
# Root directory of the TestCenter-AutoTest test harness
AUTOTEST_ROOT=C:\work\TestCenter-AutoTest
# Must match result_dir in TestCenter-AutoTest/Config/config.yaml
REGRESSION_RESULT_DIR=C:\work\regression test

# ── Skill: ccl_py_test_skill ──────────────────────────────────────────────────
# Root directory of the Python test repo
PY_TEST_REPO=C:\work\ccl-pytest
# pytest command to run; comment/uncomment to switch between full suite and single test
PY_TEST_CMD=& "C:\work\TestCenter\bin\debug_x64\Python\bin\python.exe" -m pytest -m regression
#PY_TEST_CMD=& "C:\work\TestCenter\bin\debug_x64\Python\bin\python.exe" -m pytest -m regression -k test_iq_clear_all_results.py

# ── Notification (TBD) ────────────────────────────────────────────────────────
# Teams notification will be added here after Teams repo is ready
