# GitHub Personal Access Token — required for private repos
GITHUB_TOKEN=ghp_your_token_here

# Poll interval in seconds
POLL_INTERVAL_SECONDS=60

# Repos to watch. Format: owner/repo:branch[:path1,path2]
# Multiple targets separated by |
WATCH_TARGETS=Viavi-TestCenter/testcenter:integration:content/traffic/ccl

# Comma-separated list of skills to run for each commit (in order).
# Leave empty to disable all processing.
# Example: SKILL_LIST=compile_ui_bll,ccl_regression_test_skill
SKILL_LIST=

# ── Skill: compile_ui_bll ─────────────────────────────────────────────────────
STC_BUILD_ROOT=C:\work\testcenter

# ── Skill: ccl_regression_test_skill ──────────────────────────────────────────
AUTOTEST_ROOT=C:\work\TestCenter-AutoTest

# ── Skill: ccl_py_test_skill (optional) ───────────────────────────────────────
# PY_TEST_REPO=C:\work\your-py-test-repo
# PY_TEST_CMD=& "C:\work\TestCenter\bin\Debug_x64\Python\bin\python.exe" -m pytest -m regression

# ── Notification (TBD) ────────────────────────────────────────────────────────
# Teams notification will be added here after Teams repo is ready
